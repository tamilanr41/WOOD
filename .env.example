# MongoDB Connection (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mariya_plywoods

# JWT Signing Secret (minimum 32 random characters in production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Public URL of the deployed site (used for password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Payment Gateway (Test/Live keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Cloud Image Storage (Recommended for Netlify/Vercel production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email Notifications (Order confirmation, status updates, password reset)
RESEND_API_KEY=
EMAIL_FROM=Mariya Plywoods <orders@yourdomain.com>

# Optional: Secret for one-time admin bootstrap script
ADMIN_BOOTSTRAP_SECRET=
